<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      同步地址由用户在设置页自己填，本机/局域网自建的后台服务通常是 http。
      传输层加密已按需求移除（同步的内容只有链接、备注、标签），所以这里放开明文；
      填 https 地址时仍走系统证书校验。
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
